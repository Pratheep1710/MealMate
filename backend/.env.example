# Copy to .env and fill in real values. Never commit .env — see MP-006/MP-014 (secrets are not
# committed; missing/invalid required values fail fast with an actionable error, see app/config.py).

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase direct Postgres connection (required) — used by app/db.py (MP-029/031) for repository
# access, distinct from the REST/Auth creds above. Session Pooler host from the dashboard's
# Connect panel is IPv4-compatible; its user is "postgres.<project-ref>", not plain "postgres".
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# OpenAI (required)
OPENAI_API_KEY=
OPENAI_MODEL=

# Expo (optional — only needed if Enhanced Push Notification Security is enabled)
EXPO_ACCESS_TOKEN=

# Render (optional — populated automatically by the Render runtime, not set manually)
RENDER_SERVICE_ID=
RENDER_GIT_COMMIT=
