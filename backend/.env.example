# Copy to .env and fill in real values. Never commit .env — see MP-006/MP-014 (secrets are not
# committed; missing/invalid required values fail fast with an actionable error, see app/config.py).

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (required)
OPENAI_API_KEY=
OPENAI_MODEL=

# Expo (optional — only needed if Enhanced Push Notification Security is enabled)
EXPO_ACCESS_TOKEN=

# Render (optional — populated automatically by the Render runtime, not set manually)
RENDER_SERVICE_ID=
RENDER_GIT_COMMIT=
